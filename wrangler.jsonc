{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runlater-local-prototype",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "build": {"command": "./scripts/build.sh"},
  "durable_objects": {"bindings": [{"name": "LEDGER", "class_name": "TaskLedger"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["TaskLedger"]}],
  "queues": {"producers": [{"binding": "READY", "queue": "runlater-local-ready"}], "consumers": [{"queue": "runlater-local-ready", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3}]},
  "vars": {"LOCAL_FIXTURES": "true", "API_KEY_HASHES": "{\"a6268dd66091560795a8312546a5d5d0f8009a817ff0e3918bc52edb06851a25\": \"alpha\", \"d95caa259ef270f67ab5582059821eacbe49a29a9ee4658cba90b6bb9ac82d71\": \"beta\"}"}
}
