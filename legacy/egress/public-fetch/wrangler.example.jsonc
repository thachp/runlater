{
  "name": "runlater-public-fetch-candidate",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["global_fetch_strictly_public", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "EGRESS_TRANSPORT": "worker-public-fetch-v1",
    "EGRESS_ENABLED": "false",
    "EGRESS_REVIEW_REVISION": "UNVERIFIED"
  },
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "PUBLIC_FETCH_RECEIPTS", "class_name": "PublicFetchReceipts" }] },
  "migrations": [{ "tag": "public-fetch-v1", "new_sqlite_classes": ["PublicFetchReceipts"] }]
}
