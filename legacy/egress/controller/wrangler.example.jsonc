{
  // NOT a deployment instruction. New resources and the API binding need separate approval.
  "name": "runlater-general-egress",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "EGRESS_ENABLED": "false", "EGRESS_REVIEW_REVISION": "UNVERIFIED" },
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "EGRESS_CONTAINER", "class_name": "EgressContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EgressContainer"] }],
  "containers": [{ "class_name": "EgressContainer", "image": "REQUIRES_REVIEWED_IMAGE_REFERENCE", "instance_type": "lite", "max_instances": 1 }]
}
