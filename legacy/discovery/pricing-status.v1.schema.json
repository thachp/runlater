{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.runlater.io/agent/pricing-status.v1.schema.json",
  "title": "RunLater commercial availability, not a quote",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://docs.runlater.io/agent/pricing-status.v1.schema.json"
    },
    "version": {
      "const": "1.1.0"
    },
    "status": {
      "const": "free_beta_only"
    },
    "trial_duration": {
      "const": "P7D"
    },
    "trial_task_allowance": {
      "const": 16
    },
    "credit_price": {
      "const": null
    },
    "currency": {
      "const": null
    },
    "payment_methods": {
      "const": []
    },
    "automatic_top_up": {
      "const": false
    },
    "live_purchases_enabled": {
      "const": false
    },
    "description": {
      "type": "string"
    },
    "trial_attempt_units": {
      "const": 100
    },
    "units_reserved_per_task": {
      "const": 5
    },
    "lifetime_project_capacity": {
      "const": 10
    }
  },
  "required": [
    "$schema",
    "version",
    "status",
    "trial_duration",
    "trial_task_allowance",
    "credit_price",
    "currency",
    "payment_methods",
    "automatic_top_up",
    "live_purchases_enabled",
    "description",
    "trial_attempt_units",
    "units_reserved_per_task",
    "lifetime_project_capacity"
  ]
}
