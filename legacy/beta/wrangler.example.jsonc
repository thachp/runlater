{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "runlater-public-api",
  "main": "../build/worker/shim.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {"cpu_ms": 50},
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [
    {"name": "ADMISSION", "class_name": "AdmissionRegistry"},
    {"name": "PROJECTS", "class_name": "InvitationProject"}
  ]},
  "migrations": [{"tag": "public-beta-v1", "new_sqlite_classes": ["AdmissionRegistry", "InvitationProject"]}],
  "queues": {
    "producers": [{"binding": "BETA_READY", "queue": "runlater-public-ready"}],
    "consumers": [{"queue": "runlater-public-ready", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 1}]
  },
  "ratelimits": [
    {"name": "BETA_IP_RATE", "namespace_id": "1001", "simple": {"limit": 60, "period": 60}},
    {"name": "BETA_REG_IP_RATE", "namespace_id": "1002", "simple": {"limit": 6, "period": 60}}
  ],
  "vars": {
    "PUBLIC_BETA_ENABLED": "disabled",
    "PUBLIC_BETA_PROFILE": "{}",
    "BETA_REVOKED_PROJECTS": "[]",
    "BETA_READY_QUEUE": "runlater-public-ready"
  },
  "build": {"command": "./scripts/build-production.sh", "cwd": "."}
}
