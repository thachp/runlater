{
  "name": "runlater-local",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "test:local": "node scripts/integration.mjs",
    "test:examples": "node --test examples/local-examples.test.mjs",
    "test:contract": "./scripts/build.sh && node scripts/contract.mjs",
    "example:local": "node examples/quickstart.mjs",
    "test:runtime-recovery": "./scripts/test-runtime-recovery.sh",
    "test:callback-wire": "node --test examples/callback-rotation.test.mjs",
    "test:metrics-local": "./scripts/build.sh && node scripts/metrics-integration.mjs",
    "test:transport-local": "./scripts/test-transport.sh",
    "test:pause-local": "./scripts/test-pause.sh",
    "build:discovery": "node scripts/discovery.mjs",
    "test:discovery": "node --test scripts/discovery.test.mjs",
    "test:production-identity": "./scripts/test-production-identity.sh",
    "test:signed-requests": "./scripts/test-signed-requests.sh",
    "test:funding": "./scripts/test-funding.sh",
    "test:delivery": "./scripts/test-delivery.sh",
    "test:web": "npm run test:discovery && node --test web/redirect/worker.test.mjs web/landing/worker.test.mjs scripts/web.test.mjs examples/alpha-quickstart.test.mjs",
    "build:web": "npm run build:discovery",
    "preview:web": "node scripts/preview-web.mjs",
    "test:web-local": "node scripts/test-web-local.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "wrangler": "4.154.0"
  }
}
