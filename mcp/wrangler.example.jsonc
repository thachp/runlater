{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "runlater-mcp",
  "main": "../build/mcp/worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "version_metadata": {"binding": "MCP_RELEASE_VERSION"},
  "limits": {"cpu_ms": 50},
  "durable_objects": {"bindings": [{"name": "MCP_HUB", "class_name": "McpHub"}]},
  "migrations": [{"tag": "mcp-v1", "new_sqlite_classes": ["McpHub"]}],
  "ratelimits": [
    {"name": "MCP_IP_RATE", "namespace_id": "2101", "simple": {"limit": 60, "period": 60}},
    {"name": "MCP_AUTH_RATE", "namespace_id": "2102", "simple": {"limit": 6, "period": 60}}
  ],
  "vars": {
    "MCP_ENABLED": "disabled",
    "MCP_OAUTH_ENABLED": "disabled",
    "MCP_RELEASE_ID": "EXISTING_REVIEWED_RELEASE_ID",
    "MCP_GATEWAY_PUBLIC_KEY": "REVIEWED_GATEWAY_PUBLIC_KEY",
    "MCP_SOURCE_SHA": "REVIEWED_SOURCE_SHA"
  }
}
