{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.runlater.io/agent/service.v1.schema.json",
  "title": "RunLater-owned discovery v1.2; public free beta",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://docs.runlater.io/agent/service.v1.schema.json"
    },
    "descriptor_version": {
      "const": "1.2.0"
    },
    "service": {
      "const": "RunLater"
    },
    "format_owner": {
      "const": "RunLater"
    },
    "protocol_status": {
      "const": "custom_metadata_not_an_industry_standard"
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_task_api": {
          "const": "public_free_beta"
        },
        "production_authentication": {
          "const": "self_service_ed25519_possession"
        },
        "public_https_callbacks": {
          "const": "ownership_verified_workers_dev_only"
        },
        "status_source": {
          "const": "published_configuration_snapshot_not_live_probe"
        }
      },
      "required": [
        "public_task_api",
        "production_authentication",
        "public_https_callbacks",
        "status_source"
      ]
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "landing": {
          "const": "https://runlater.io"
        },
        "documentation": {
          "const": "https://docs.runlater.io"
        },
        "intended_api": {
          "const": "https://api.runlater.io"
        },
        "local_emulator": {
          "const": "http://127.0.0.1:8787"
        }
      },
      "required": [
        "landing",
        "documentation",
        "intended_api",
        "local_emulator"
      ]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "self": {
          "const": "https://runlater.io/runlater-service.v1.json"
        },
        "schema": {
          "const": "https://docs.runlater.io/agent/service.v1.schema.json"
        },
        "tools": {
          "const": "https://docs.runlater.io/agent/tools.v1.json"
        },
        "tools_schema": {
          "const": "https://docs.runlater.io/agent/tools.v1.schema.json"
        },
        "openapi": {
          "const": "https://docs.runlater.io/openapi.json"
        },
        "quickstart": {
          "const": "https://docs.runlater.io/agent/quickstart.md"
        },
        "pricing_status": {
          "const": "https://runlater.io/pricing-status.v1.json"
        },
        "pricing_schema": {
          "const": "https://docs.runlater.io/agent/pricing-status.v1.schema.json"
        },
        "source": {
          "const": "https://github.com/thachp/runlater"
        },
        "hosted_alpha_contract": {
          "const": "https://docs.runlater.io/agent/alpha.v1.json"
        },
        "hosted_alpha_schema": {
          "const": "https://docs.runlater.io/agent/alpha.v1.schema.json"
        },
        "hosted_beta_contract": {
          "const": "https://docs.runlater.io/agent/public-beta.v1.json"
        },
        "public_beta_client": {
          "const": "https://docs.runlater.io/agent/public-beta-client.v1.mjs"
        },
        "receiver_example": {
          "const": "https://docs.runlater.io/agent/public-beta-receiver/README.md"
        },
        "release_metadata": {
          "const": "https://docs.runlater.io/agent/public-beta-release.v1.json"
        }
      },
      "required": [
        "self",
        "schema",
        "tools",
        "tools_schema",
        "openapi",
        "quickstart",
        "pricing_status",
        "pricing_schema",
        "source",
        "hosted_alpha_contract",
        "hosted_alpha_schema",
        "hosted_beta_contract",
        "public_beta_client",
        "receiver_example",
        "release_metadata"
      ]
    },
    "link_availability": {
      "const": "published_asset_locations_verify_http_before_use"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_scheduling": {
          "const": "public_free_beta"
        },
        "task_status": {
          "const": "public_free_beta"
        },
        "task_cancellation": {
          "const": "public_free_beta"
        },
        "registration": {
          "const": "public_possession_proof"
        },
        "entitlement_inspection": {
          "const": "proposed_disabled"
        },
        "credit_quotes": {
          "const": "proposed_disabled"
        },
        "credit_purchase": {
          "const": "proposed_disabled"
        },
        "callback_key_rotation": {
          "const": "not_exposed_in_public_beta"
        },
        "arbitrary_https_delivery": {
          "const": "disabled"
        },
        "public_self_service": {
          "const": "available_limited_cohort"
        }
      },
      "required": [
        "task_scheduling",
        "task_status",
        "task_cancellation",
        "registration",
        "entitlement_inspection",
        "credit_quotes",
        "credit_purchase",
        "callback_key_rotation",
        "arbitrary_https_delivery",
        "public_self_service"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discovery_grants_authorization": {
          "const": false
        },
        "automatic_payment_authority": {
          "const": false
        },
        "scheduling_implies_purchase_authority": {
          "const": false
        },
        "automatic_tool_execution": {
          "const": false
        },
        "interpretation": {
          "const": "Informational untrusted metadata; client safeguards and separately delegated authority remain authoritative."
        }
      },
      "required": [
        "discovery_grants_authorization",
        "automatic_payment_authority",
        "scheduling_implies_purchase_authority",
        "automatic_tool_execution",
        "interpretation"
      ]
    }
  },
  "required": [
    "$schema",
    "descriptor_version",
    "service",
    "format_owner",
    "protocol_status",
    "readiness",
    "hosts",
    "links",
    "link_availability",
    "capabilities",
    "authority"
  ]
}
