{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.runlater.io/agent/tools.v1.schema.json",
  "title": "Custom RunLater tool metadata; not MCP or an installed executor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://docs.runlater.io/agent/tools.v1.schema.json"
    },
    "version": {
      "const": "1.0.0"
    },
    "format_owner": {
      "const": "RunLater"
    },
    "protocol_status": {
      "const": "custom_data_not_tool_registration_or_authorization"
    },
    "canonical_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "const": "https://docs.runlater.io/openapi.json"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "url",
        "version",
        "sha256"
      ]
    },
    "automatic_execution": {
      "const": false
    },
    "hosted_enabled": {
      "const": false
    },
    "tools": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "schedule_task",
                  "task_status",
                  "cancel_task"
                ]
              },
              "description": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "schedule",
                  "read",
                  "cancel",
                  "registration",
                  "potential_spend"
                ]
              },
              "hosted_enabled": {
                "const": false
              },
              "local_enabled": {
                "const": true
              },
              "input_stability": {
                "const": "derived_from_canonical_local_openapi"
              },
              "binding": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "enum": [
                      "GET",
                      "POST"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/v1/"
                  },
                  "operation_id": {
                    "type": "string"
                  },
                  "required_permission": {
                    "enum": [
                      "enqueue",
                      "read",
                      "cancel"
                    ]
                  }
                },
                "required": [
                  "method",
                  "path",
                  "operation_id",
                  "required_permission"
                ]
              },
              "input_schema": {
                "type": "object"
              },
              "credential_transport": {
                "const": "authorization_header_managed_by_authorized_client_not_tool_arguments"
              }
            },
            "required": [
              "name",
              "description",
              "effect",
              "hosted_enabled",
              "local_enabled",
              "input_stability",
              "binding",
              "input_schema",
              "credential_transport"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "registration_challenge",
                  "complete_registration",
                  "inspect_entitlements",
                  "request_credit_quote",
                  "initiate_credit_purchase"
                ]
              },
              "description": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "schedule",
                  "read",
                  "cancel",
                  "registration",
                  "potential_spend"
                ]
              },
              "hosted_enabled": {
                "const": false
              },
              "local_enabled": {
                "const": false
              },
              "input_stability": {
                "const": "illustrative_nonbinding_proposal"
              },
              "binding": {
                "type": "null"
              },
              "input_schema": {
                "type": "object"
              },
              "credential_transport": {
                "const": "authorization_header_managed_by_authorized_client_not_tool_arguments"
              },
              "tracking_issue": {
                "type": "integer",
                "minimum": 27,
                "maximum": 30
              },
              "purchase_authority": {
                "const": "separate_wallet_delegation_required_before_any_future_spend"
              }
            },
            "required": [
              "name",
              "description",
              "effect",
              "hosted_enabled",
              "local_enabled",
              "input_stability",
              "binding",
              "input_schema",
              "credential_transport",
              "tracking_issue",
              "purchase_authority"
            ]
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "schedule_task"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "task_status"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "cancel_task"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "registration_challenge"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "complete_registration"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "inspect_entitlements"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "request_credit_quote"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "initiate_credit_purchase"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "hosted_contract": {
      "const": "https://docs.runlater.io/agent/alpha.v1.json"
    }
  },
  "required": [
    "$schema",
    "version",
    "format_owner",
    "protocol_status",
    "canonical_contract",
    "automatic_execution",
    "hosted_enabled",
    "tools",
    "hosted_contract"
  ]
}
