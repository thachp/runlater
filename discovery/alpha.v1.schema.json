{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.runlater.io/agent/alpha.v1.schema.json",
  "title": "RunLater restricted-alpha contract metadata v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://docs.runlater.io/agent/alpha.v1.schema.json"
    },
    "version": {
      "const": "1.0.0"
    },
    "format_owner": {
      "const": "RunLater"
    },
    "protocol_status": {
      "const": "custom_contract_metadata_not_authorization"
    },
    "base_url": {
      "const": "https://api.runlater.io"
    },
    "access": {
      "const": "operator_approved_only"
    },
    "readiness_note": {
      "const": "Feature availability is a published configuration snapshot. Health is not proof of a usable identity, grant or destination. Check current authority and handle expiry/revocation. No public signup or payment flow."
    },
    "health_url": {
      "const": "https://api.runlater.io/health"
    },
    "receiver": {
      "const": "owned_side_effect_free_synthetic_only"
    },
    "authentication": {
      "const": {
        "algorithm": "Ed25519",
        "origin": "https://api.runlater.io",
        "request_prefix": "RunLater signed request v1\n",
        "request_tuple": [
          "version",
          "origin",
          "project_id",
          "public_key",
          "method",
          "path",
          "query",
          "body_sha256",
          "idempotency_key",
          "issued_at_ms",
          "expires_at_ms",
          "nonce"
        ],
        "encoding": "UTF-8 prefix plus compact JSON array; no trailing newline; version is integer1; digest is lowercase SHA256 of exact body bytes; empty query only",
        "maximum_signature_ms": 60000,
        "headers": [
          "RunLater-Project-Id",
          "RunLater-Public-Key",
          "RunLater-Nonce",
          "RunLater-Issued-At",
          "RunLater-Expires-At",
          "RunLater-Request-Signature"
        ],
        "bearer_supported": false,
        "private_key_transport": "never_sent; authorized_client_signs_locally"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "required_permission": {
            "enum": [
              null,
              "read",
              "enqueue",
              "cancel",
              "redrive"
            ]
          },
          "authentication": {
            "enum": [
              "none",
              "operator_allowlisted_project_and_key",
              "single_use_possession_proof",
              "signed"
            ]
          },
          "body_definition": {
            "enum": [
              null,
              "Issue",
              "Enroll",
              "Create",
              "Empty"
            ]
          },
          "idempotency_key_required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "method",
          "path",
          "required_permission",
          "authentication",
          "body_definition",
          "idempotency_key_required"
        ]
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Issue",
        "Enroll",
        "Create",
        "Empty",
        "TaskId"
      ],
      "properties": {
        "Issue": {
          "type": "object"
        },
        "Enroll": {
          "type": "object"
        },
        "Create": {
          "type": "object"
        },
        "Empty": {
          "type": "object"
        },
        "TaskId": {
          "type": "object"
        }
      }
    },
    "limits": {
      "const": {
        "request_body_bytes": 2048,
        "callback_body_bytes": 1024,
        "logical_attempts_per_task": 5,
        "retry_age_ms": 86400000,
        "project_lifetime_admissions": 16,
        "project_lifetime_publications": 128
      }
    },
    "authority": {
      "const": {
        "automatic_execution": false,
        "payment_authority": false,
        "self_service_registration": false
      }
    }
  },
  "required": [
    "$schema",
    "version",
    "format_owner",
    "protocol_status",
    "base_url",
    "access",
    "readiness_note",
    "health_url",
    "receiver",
    "authentication",
    "routes",
    "definitions",
    "limits",
    "authority"
  ]
}
