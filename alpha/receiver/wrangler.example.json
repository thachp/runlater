{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-alpha-receiver",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {"cpu_ms": 50},
  "observability": {"enabled": false},
  "routes": [{"pattern": "receiver-alpha.runlater.io", "custom_domain": true}],
  "durable_objects": {"bindings": [{"name": "IDENTITIES", "class_name": "ProjectIdentity", "script_name": "runlater-alpha-api"}]}
}
