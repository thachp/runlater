          "401": {
            "description": "Unauthorized"
          },
          "415": {
            "description": "Expected application/json"
          },
          "503": {
            "description": "Prototype disabled or malformed authentication configuration"
          },
          "403": {
            "description": "Project credential lacks required read permission"
          }
        },
        "x-required-permission": "read"
      },
      "put": {
        "operationId": "configureDefaultQueueLimits",
        "description": "CQRS command replaces all limits. Lowering limits gates future work without revoking existing leases. Reconfiguration never resets rate tokens.",
