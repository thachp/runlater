            "name": "key_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Atomically issue a new immutable key and schedule source revocation. Overlap <=24h; no validity gap permitted; replays are keyed by the new immutable key ID.",
