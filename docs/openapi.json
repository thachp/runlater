          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "new_key",
                  "revoke_old_at_ms"
                ],
                "properties": {
                  "new_key": {
                    "$ref": "#/components/schemas/NewLocalKey"
                  },
                  "revoke_old_at_ms": {
                    "type": "integer",
                    "format": "int64"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing/current redacted result",
