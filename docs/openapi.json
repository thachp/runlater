            "description": "Malformed DTO, unsupported local policy or lifetime"
          },
          "401": {
            "description": "Invalid, revoked, not-yet-valid or expired project credential"
          },
          "403": {
            "description": "Missing operation permission or attempted privilege escalation"
          },
          "404": {
            "description": "Unknown project-owned key"
          },
          "409": {
            "description": "Immutable key/rotation identity conflict"
          },
          "429": {
            "description": "64 retained local keys maximum per project"
          },
          "503": {
            "description": "Nonproduction prototype/configuration gate closed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "projectToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Local fixtures only: legacy local-alpha/local-beta bootstrap tokens, or rl_local.<tenant>.<key_id>.<public_fixture_secret>. Production provisioning is gated."
      }
    },
    "schemas": {
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "destination",
          "body",
          "operation_key"
        ],
        "properties": {
          "destination": {
            "type": "string",
            "enum": [
              "fixture://success",
              "fixture://retry",
              "fixture://fail"
            ]
          },
          "body": {
            "type": "string",
            "maxLength": 16384,
            "description": "UTF-8 byte bound is also enforced"
          },
          "operation_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "Business operation identity, preserved on redrive"
          },
          "run_at_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "default": 0,
            "description": "UTC Unix milliseconds; 0 or omitted means immediate; max 365 days ahead"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/Create"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "ready",
              "running",
              "retry_wait",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "due_ms": {
            "type": "integer"
          },
          "generation": {
            "type": "integer"
          },
          "fence": {
            "type": "integer"
          },
          "lease_until": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cancel_requested": {
            "type": "boolean"
          },
          "terminal_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "initial_due_ms": {
            "type": "integer",
            "description": "Persisted initial actual due time used for retry age, separate from canonical input"
          }
        },
        "required": [
          "id",
          "input",
          "status",
          "generation"
        ]
      },
      "Attempt": {
        "type": "object",
        "required": [
          "fence",
          "started_ms"
        ],
        "properties": {
          "fence": {
            "type": "integer"
          },
          "started_ms": {
            "type": "integer"
          },
          "finished_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "QueueLimits": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "max_active_tasks",
          "max_payload_bytes",
          "max_concurrent",
          "dispatch_per_second",
          "dispatch_burst"
        ],
        "properties": {
          "max_active_tasks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1000
          },
          "max_payload_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 131072,
            "default": 131072
          },
          "max_concurrent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 4
          },
          "dispatch_per_second": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "dispatch_burst": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "description": "All values proposed local prototype limits. One tenant-wide default logical queue per project; no multiple-queue sharding."
      },
      "NewLocalKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "token_sha256",
          "permissions",
          "expires_at_ms"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "Immutable local key ID; bootstrap_ prefix reserved"
          },
          "token_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of complete nonproduction rl_local.<tenant>.<key_id>.<secret> token. Server never receives raw secret in this body."
          },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "enqueue",
                "read",
                "cancel",
                "redrive",
                "configure",
                "manage_keys"
              ]
            }
          },
          "not_before_ms": {
            "type": "integer",
            "format": "int64",
            "default": 0,
            "minimum": 0
          },
          "expires_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Exclusive UTC ms cutoff, future and no more than 30 days ahead; proposed local policy"
          }
        }
      },
      "KeyView": {
        "type": "object",
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "Immutable local key ID; bootstrap_ prefix reserved"
          },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "enqueue",
                "read",
                "cancel",
                "redrive",
                "configure",
                "manage_keys"
              ]
            }
          },
          "not_before_ms": {
            "type": "integer",
            "format": "int64",
            "default": 0,
            "minimum": 0
          },
          "expires_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Exclusive UTC ms cutoff; legacy local bootstrap fixtures have an effectively unbounded cutoff."
          },
          "created_ms": {
            "type": "integer",
            "format": "int64"
          },
          "revoked_at_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rotated_from": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "No credential verifier or plaintext token is returned."
      },
      "TaskReceipt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "ready",
              "running",
              "retry_wait",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "generation": {
            "type": "integer"
          },
          "cancel_requested": {
            "type": "boolean"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "Returned for task mutation permissions without read; excludes payload, destination and attempts.",
        "required": [
          "id",
          "status",
          "generation",
          "cancel_requested",
          "parent"
        ],
        "additionalProperties": false
      }
    }
  }
}
