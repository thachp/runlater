{
  "openapi": "3.1.0",
  "info": {
    "title": "RunLater LOCAL prototype",
    "version": "0.3.0",
    "description": "No production service. At-least-once design; no ordering or exact-time guarantee. Active idempotency plus 30 days after termination. All numeric limits proposed. Arbitrary outbound HTTPS disabled."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local emulator only"
    }
  ],
  "security": [
    {
      "projectToken": []
    }
  ],
  "paths": {
    "/v1/tasks": {
      "post": {
        "operationId": "createTask",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Create"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Durably accepted",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Task"
                    },
                    {
                      "$ref": "#/components/schemas/TaskReceipt"
                    }
                  ]
                }
              }
            }
          },
          "200": {
            "description": "Same canonical input and key returns original task",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Task"
                    },
                    {
                      "$ref": "#/components/schemas/TaskReceipt"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found in authenticated tenant"
          },
          "409": {
            "description": "Idempotency conflict or invalid transition"
          },
          "413": {
            "description": "Envelope too large"
          },
          "422": {
            "description": "Destination disabled"
          },
          "429": {
            "description": "Admission deferred. Existing idempotent results still replay. Retained payload capacity may require retention expiry or config change.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Seconds rounded up from retry_after_ms; a retry hint, not guaranteed admission"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "active_tasks",
                        "payload_bytes",
                        "concurrency",
                        "dispatch_rate"
                      ]
                    },
                    "retry_after_ms": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Prototype disabled"
          },
          "415": {
            "description": "Expected application/json for JSON request body"
          },
          "403": {
            "description": "Project credential lacks required enqueue permission"
          }
        },
        "x-required-permission": "enqueue"
      },
      "get": {
        "operationId": "listTasks",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
