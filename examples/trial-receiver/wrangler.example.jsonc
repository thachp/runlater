{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-trial-receiver-example",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {"RECEIVER_ENABLED": "disabled"},
  "durable_objects": {"bindings": [{"name": "INBOX", "class_name": "TrialReceiverInbox"}]},
  "migrations": [{"tag": "trial-receiver-v1", "new_sqlite_classes": ["TrialReceiverInbox"]}]
}
