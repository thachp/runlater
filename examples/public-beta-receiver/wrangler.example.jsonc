{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-public-beta-receiver-example",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {"RECEIVER_ENABLED": "disabled"},
  "durable_objects": {"bindings": [{"name": "INBOX", "class_name": "ReceiverInbox"}]},
  "migrations": [{"tag": "receiver-v1", "new_sqlite_classes": ["ReceiverInbox"]}]
}
