{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-api",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-27",
  // Internal only: the gateway reaches this Worker through a service binding.
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "worker-build --release" },
  "env": {
    "staging": { "name": "runlater-api-staging" },
    "production": { "name": "runlater-api-production" }
  }
}
