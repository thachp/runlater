{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  // Better Auth needs Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Secrets, set per environment with `wrangler secret put` (see docs/DEPLOY.md):
  //   ASSERTION_PRIVATE_KEY  hex 32-byte Ed25519 seed; the API's GATEWAY_PUBLIC_KEY is its public key
  //   BETTER_AUTH_SECRET     32+ random bytes
  "vars": { "PUBLIC_URL": "http://localhost:8787" },
  // The task API is private; the gateway is its only caller.
  "services": [{ "binding": "API", "service": "runlater-api" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "runlater-gateway", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "AuthStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthStore"] }],
  "ratelimits": [{ "name": "REGISTER_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "env": {
    // database_id: replace with the id printed by `wrangler d1 create` (docs/DEPLOY.md, phase 4).
    "staging": {
      "name": "runlater-gateway-staging",
      "vars": { "PUBLIC_URL": "https://gateway-staging.runlater.io" },
      "services": [{ "binding": "API", "service": "runlater-api-staging" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "runlater-gateway-staging", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "AuthStore" }] },
      "ratelimits": [{ "name": "REGISTER_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
    },
    "production": {
      "name": "runlater-gateway-production",
      "vars": { "PUBLIC_URL": "https://gateway.runlater.io" },
      "services": [{ "binding": "API", "service": "runlater-api-production" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "runlater-gateway-production", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "AuthStore" }] },
      "ratelimits": [{ "name": "REGISTER_RATE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }]
    }
  }
}
