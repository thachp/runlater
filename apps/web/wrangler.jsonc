{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": { "name": "runlater-web-staging" },
    "production": {
      "name": "runlater-web-production",
      // Taken over from the legacy runlater-web-landing Worker on deploy.
      "routes": [
        { "pattern": "runlater.io", "custom_domain": true },
        { "pattern": "www.runlater.io", "custom_domain": true }
      ]
    }
  }
}
