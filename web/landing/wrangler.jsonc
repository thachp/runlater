{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-web-landing",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../build/discovery/landing",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "main": "worker.mjs",
  "limits": {
    "cpu_ms": 10
  }
}
