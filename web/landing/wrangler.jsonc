{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-web-landing",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  },
  "main": "worker-next.mjs",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ]
}
