{
  "name": "runlater-agent-auth-local-proof",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:protocol && npm run test:coordinator && npm run test:replacement && npm run test:bridge && npm run test:canonical",
    "test:protocol": "node --test prototype.test.mjs",
    "test:coordinator": "node --test coordinator/coordinator.test.mjs",
    "test:replacement": "node replacement/generate-schema.mjs --check && node --test replacement/*.test.mjs",
    "schema:replacement": "node replacement/generate-schema.mjs",
    "test:bridge": "node --test replacement/bridge/*.test.mjs",
    "test:canonical": "node --test canonical/*.test.mjs"
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.6.2",
    "better-auth": "1.7.14",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@auth/agent": "0.6.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta"
  }
}
